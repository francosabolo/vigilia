# Cloud platform URL and the token printed by: php artisan seguria:edge-create {site} {name}
SEGURIA_API_URL=https://seguria.test
SEGURIA_TOKEN=edge_xxx
HEARTBEAT_SECONDS=60
# Automatic deterrence (zones at "Disuasión automática"): a shell command that plays the message on the site's
# speaker or siren. It receives SEGURIA_CAMERA and SEGURIA_MESSAGE. Empty = not available.
# Example (Hikvision alarm output 1): curl -s --digest -u admin:PASS -X PUT -d '<IOPortData><outputState>high</outputState></IOPortData>' http://CAMERA_IP/ISAPI/System/IO/outputs/1/trigger
SEGURIA_DETER_COMMAND=
# Update from the console (Equipos > Actualizar), e.g.: cd /opt/vigilia/edge && docker compose pull && docker compose up -d
SEGURIA_UPDATE_COMMAND=
